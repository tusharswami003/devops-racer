
name: Docker Build and Test

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  docker-build-and-test:
    name: Build and smoke-test Docker image
    runs-on: ubuntu-latest

    steps:
      - name: Checkout source code
        uses: actions/checkout@v7

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v4

      - name: Build Docker image
        uses: docker/build-push-action@v7
        with:
          context: .
          file: ./Dockerfile
          push: false
          load: true
          tags: devops-racer:${{ github.sha }}

      - name: Run container and smoke-test website
        shell: bash
        run: |
          set -euo pipefail

          IMAGE="devops-racer:${GITHUB_SHA}"
          CONTAINER="devops-racer-smoke-test"
          RESPONSE="${RUNNER_TEMP}/devops-racer-index.html"

          # Start the container and publish port 80 locally
          # on the GitHub Actions runner.
          docker run --detach --rm \
            --name "${CONTAINER}" \
            --publish 127.0.0.1:8080:80 \
            "${IMAGE}"

          # Always stop and remove the test container.
          cleanup() {
            docker stop "${CONTAINER}" >/dev/null 2>&1 || true
          }
          trap cleanup EXIT

          # Give Nginx up to 30 seconds to serve the website.
          for attempt in $(seq 1 30); do
            if curl --fail --silent \
              --output "${RESPONSE}" \
              http://127.0.0.1:8080/; then
              break
            fi

            sleep 1
          done

          # Fail if the container did not serve a page.
          if [[ ! -s "${RESPONSE}" ]]; then
            echo "::error::Container did not return a non-empty HTTP success response."
            docker logs "${CONTAINER}"
            exit 1
          fi

          # Confirm that the response looks like HTML.
          if ! grep -Eiq '<!doctype html|<html' "${RESPONSE}"; then
            echo "::error::Response is not recognized as an HTML page."
            head -c 500 "${RESPONSE}"
            docker logs "${CONTAINER}"
            exit 1
          fi

          echo "Smoke test passed: the container served an HTML page."
